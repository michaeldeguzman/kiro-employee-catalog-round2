# ──────────────────────────────────────────────────────────────────────────────
# OutSystems REST Test Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# Base URL of your OutSystems environment, e.g.:
#   https://your-org.outsystemscloud.com/EmployeeCatalog/rest/EmployeeAPI
OUTSYSTEMS_BASE_URL=

# Optional API key (sent as X-API-Key header).
# Set this if your OutSystems REST service is protected by an API key.
OUTSYSTEMS_API_KEY=
